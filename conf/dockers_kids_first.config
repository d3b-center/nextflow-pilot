process {
    withName: VERIFYBAMID_VERIFYBAMID2 {
        container = 'quay.io/biocontainers/verifybamid2:1.0.6--h32f71e1_3'
    }
    withName: 'SAMTOOLS_VIEW_CRAM|SAMTOOLS_VIEW_RG|SAMTOOLS_IDXSTATS' {
        container = 'quay.io/biocontainers/samtools:1.21--h50ea8bc_0'
    }
    withName: 'CUTADAPT_.*' {
        container = 'quay.io/biocontainers/cutadapt:4.6--py39hf95cd2a_1'
    }
    withName: 'PICARD_RENAMESAMPLEINVCF' {
        container = 'quay.io/biocontainers/picard:3.3.0--hdfd78af_0'
    }
    withName: 'TABIX_.*' {
        container = 'quay.io/biocontainers/htslib:1.20--h5efdd21_2'
    }
}
